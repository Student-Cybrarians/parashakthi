{
  "name": "parashakthi",
  "version": "0.2.1",
  "private": true,
  "description": "Real-time desktop meeting and interview assistant",
  "main": "main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --no-sandbox --disable-gpu",
    "test": "node --test test",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "electron": "^40.5.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.studentcybrarians.parashakthi",
    "productName": "Parashakthi",
    "directories": { "output": "dist" },
    "files": ["**/*", "!dist/**/*", "!.git/**/*", "!.env*"],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "Parashakthi captures desktop audio that you explicitly start so it can transcribe your meeting locally or with your configured speech provider.",
        "NSScreenCaptureUsageDescription": "Parashakthi captures the desktop only when you start meeting context capture."
      }
    },
    "win": { "target": ["nsis", "zip"] },
    "linux": { "target": ["AppImage", "deb"] }
  }
}
